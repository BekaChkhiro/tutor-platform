// Prisma schema — Neon Postgres (Frankfurt).
// Connection URLs live in prisma.config.ts (Prisma 7+).
//
// Sensitive fields (Tutor.iban, Tutor.idDocument) are application-layer
// encrypted before persistence. The schema stores ciphertext as String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum UserRole {
  USER
  TUTOR
  ADMIN
}

enum TutorStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  PAID
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
  NO_SHOW
  EXPIRED
}

enum PayoutStatus {
  HELD
  RELEASED
  REFUNDED
}

enum BookingType {
  FIXED
  FLEXIBLE
}

enum ExceptionType {
  BLOCK
  EXTRA
}

enum PaymentProvider {
  TBC
  BOG
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Auth: User + NextAuth adapter models ──────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  firstName     String?
  lastName      String?
  phone         String?
  dob           DateTime? @db.Date
  image         String?
  role          UserRole  @default(USER)
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  tutor           Tutor?
  bookings        Booking[]        @relation("UserBookings")
  reviews         Review[]
  messages        Message[]        @relation("MessageSender")
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
  adminLogs       AdminLog[]       @relation("AdminLogActor")
  tosAcceptances  TosAcceptance[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tutor profile + supporting collections ─────────────────────────────

model Tutor {
  id            String      @id @default(cuid())
  userId        String      @unique
  status        TutorStatus @default(PENDING_REVIEW)
  slug          String      @unique
  headline      String?
  bio           String?     @db.Text
  photoUrl      String?
  introVideoUrl String?
  gender        String?
  iban               String?
  idDocument         String?
  refundPolicy       Json?
  onboardingStep     Int     @default(1)
  onboardingComplete Boolean @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                 Skill[]
  certificates           Certificate[]
  educations             Education[]
  experiences            Experience[]
  categories             TutorCategory[]
  consultations          Consultation[]
  availabilities         Availability[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]               @relation("TutorBookings")
  reviews                Review[]

  @@index([status])
}

model Skill {
  id        String @id @default(cuid())
  tutorId   String
  name      String
  sortOrder Int    @default(0)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model Certificate {
  id        String    @id @default(cuid())
  tutorId   String
  title     String
  issuer    String?
  issuedAt  DateTime? @db.Date
  fileUrl   String?
  sortOrder Int       @default(0)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model Education {
  id           String @id @default(cuid())
  tutorId      String
  institution  String
  degree       String?
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  sortOrder    Int    @default(0)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model Experience {
  id          String  @id @default(cuid())
  tutorId     String
  company     String
  role        String
  startYear   Int?
  endYear     Int?
  description String? @db.Text
  sortOrder   Int     @default(0)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model CommonSkill {
  id       String @id @default(cuid())
  name     String @unique
  category String @default("General")
}

// ─── Catalog: Categories ↔ Tutors ↔ Consultations ──────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  iconName    String?
  sortOrder   Int     @default(0)

  tutors        TutorCategory[]
  consultations Consultation[]
}

model TutorCategory {
  tutorId    String
  categoryId String

  tutor    Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([tutorId, categoryId])
  @@index([categoryId])
}

model Consultation {
  id                   String      @id @default(cuid())
  tutorId              String
  title                String
  descriptionShort     String
  descriptionLong      String      @db.Text
  categoryId           String
  durationMinutes      Int
  priceGel             Decimal     @db.Decimal(10, 2)
  bookingType          BookingType
  maxPerDay            Int?
  advanceNoticeMinutes Int         @default(0)
  archived             Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tutor    Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id])
  bookings Booking[]

  @@index([tutorId, archived])
  @@index([categoryId])
}

// ─── Availability ──────────────────────────────────────────────────────

model Availability {
  id        String   @id @default(cuid())
  tutorId   String
  weekday   Int
  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, weekday])
}

model AvailabilityException {
  id        String        @id @default(cuid())
  tutorId   String
  date      DateTime      @db.Date
  startTime DateTime      @db.Time(0)
  endTime   DateTime      @db.Time(0)
  type      ExceptionType

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, date])
}

// ─── Bookings, transactions, reviews, chat ─────────────────────────────

model Booking {
  id                 String        @id @default(cuid())
  userId             String
  tutorId            String
  consultationId     String
  startTime          DateTime
  endTime            DateTime
  status             BookingStatus @default(PENDING)
  expiresAt          DateTime?
  reminder24SentAt   DateTime?
  reminder1SentAt    DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user         User         @relation("UserBookings", fields: [userId], references: [id])
  tutor        Tutor        @relation("TutorBookings", fields: [tutorId], references: [id])
  consultation Consultation @relation(fields: [consultationId], references: [id])
  transaction  Transaction?
  review       Review?
  messages     Message[]

  // Race-condition guard: a tutor cannot have two bookings starting at the
  // same instant. Application code also enforces overlap rules.
  @@unique([tutorId, startTime])
  @@index([tutorId, status])
  @@index([userId, status])
  @@index([startTime])
}

model Transaction {
  id            String          @id @default(cuid())
  bookingId     String          @unique
  amountGel     Decimal         @db.Decimal(10, 2)
  commissionGel Decimal         @db.Decimal(10, 2)
  payoutGel     Decimal         @db.Decimal(10, 2)
  provider      PaymentProvider
  providerRef   String
  payoutStatus  PayoutStatus    @default(HELD)
  paidAt        DateTime?
  refundedAt    DateTime?
  createdAt     DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([payoutStatus])
  @@index([provider, providerRef])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  userId    String
  tutorId   String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  tutor   Tutor   @relation(fields: [tutorId], references: [id])

  @@index([tutorId])
}

model Message {
  id        String    @id @default(cuid())
  bookingId String
  senderId  String
  body      String    @db.Text
  fileUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
  @@index([senderId])
}

// ─── Support, admin log, ToS ───────────────────────────────────────────

model SupportTicket {
  id        String              @id @default(cuid())
  userId    String?
  subject   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  body      String   @db.Text
  fileUrl   String?
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId, createdAt])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminLogActor", fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model TosAcceptance {
  id         String   @id @default(cuid())
  userId     String
  tosVersion String
  acceptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
