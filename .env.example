# Neon Postgres connection (dev branch).
# Pooled (PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct (no pooler) — used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
