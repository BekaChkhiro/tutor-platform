# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Pooled (PgBouncer) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct (no pooler) — used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth (NextAuth.js)
# ---------------------------------------------------------------------------
# Public URL of this deployment (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"
# Random secret used to sign JWTs / cookies. Generate with: `openssl rand -base64 32`.
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_placeholder"
# Verified "from" address — must match the domain you verify in Resend.
EMAIL_FROM="no-reply@tutorplatform.ge"
# Admin notification recipient for contact form submissions.
ADMIN_EMAIL="admin@tutorplatform.ge"

# ---------------------------------------------------------------------------
# hCaptcha (contact form anti-spam)
# ---------------------------------------------------------------------------
# Sign up at https://hcaptcha.com — add both to your Vercel / .env.local.
# NEXT_PUBLIC_HCAPTCHA_SITEKEY is exposed to the browser (safe to be public).
# HCAPTCHA_SECRET is server-only; never commit the real value.
NEXT_PUBLIC_HCAPTCHA_SITEKEY="10000000-ffff-ffff-ffff-000000000001"
HCAPTCHA_SECRET="0x0000000000000000000000000000000000000000"

# ---------------------------------------------------------------------------
# Cloudflare R2 (profile photos, uploads)
# ---------------------------------------------------------------------------
# Account ID from https://dash.cloudflare.com — "Account Home" page.
R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2 API token — "Edit: Read & Write Objects" on the specific bucket.
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# Bucket name (create via Cloudflare dashboard → R2 → Create bucket).
R2_BUCKET="tutor-platform-assets"
# Public URL for the bucket (custom domain or the r2.dev subdomain).
# Enable "Public access" on the bucket and copy the public URL.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

